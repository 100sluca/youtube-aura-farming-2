{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard-live",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "3001"],
      "cwd": "apps/dashboard",
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "online",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "dev", "--port", "8787", "--ip", "127.0.0.1"],
      "cwd": "apps/online",
      "port": 8787,
      "autoPort": false
    }
  ]
}
