{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "stable_audio_3_small_sfx.safetensors" },
    "_meta": { "title": "MODEL" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "t5gemma_b_b_ul2.safetensors", "type": "stable_audio", "device": "default" },
    "_meta": { "title": "Text encoder (T5Gemma)" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["2", 0], "text": "" },
    "_meta": { "title": "PROMPT" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["2", 0], "text": "" },
    "_meta": { "title": "NEGATIVE" }
  },
  "5": {
    "class_type": "EmptyLatentAudio",
    "inputs": { "seconds": 10.0, "batch_size": 1 },
    "_meta": { "title": "SIZE" }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "lcm",
      "scheduler": "simple",
      "positive": ["3", 0],
      "negative": ["4", 0],
      "latent_image": ["5", 0],
      "denoise": 1.0
    },
    "_meta": { "title": "SEED" }
  },
  "7": {
    "class_type": "VAEDecodeAudio",
    "inputs": { "samples": ["6", 0], "vae": ["1", 2] }
  },
  "8": {
    "class_type": "SaveAudio",
    "inputs": { "audio": ["7", 0], "filename_prefix": "yt2/sfx" },
    "_meta": { "title": "OUTPUT" }
  }
}
