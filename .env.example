# ---------------------------------------------------------------------------
# Dashboard (apps/dashboard/.env.local)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # routes serveur uniquement (cron métriques, OAuth callback)
CREDENTIALS_KEY=                      # 32 octets base64 : chiffrement des refresh tokens
GOOGLE_CLIENT_ID=                     # OAuth "application Web", redirect: https://<dashboard>/api/youtube/callback
GOOGLE_CLIENT_SECRET=
OAUTH_STATE_SECRET=                   # aléatoire : signe le paramètre state du flux OAuth
NEXT_PUBLIC_APP_URL=http://localhost:3000  # base des redirections OAuth (prod : https://<dashboard>)
NEXT_PUBLIC_MOCK=1                    # 1 = données factices (démo sans Supabase)

# ---------------------------------------------------------------------------
# Worker local (services/worker/.env)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres  # « Session pooler »
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
WORKER_ID=desktop-4060
WORKER_JOB_TYPES=script,generate_clip,tts,assemble,qa,upload,ideate,improve
DATA_DIR=./data                       # clips, masters, finals (restent sur le PC)

# Fournisseurs (pluggables, voir docs/03-pipeline.md)
LLM_PROVIDER=anthropic                # anthropic | ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

VIDEO_PROVIDER=comfy_ltx              # comfy_ltx | comfy_wan | higgsfield | fal
COMFY_BASE_URL=http://127.0.0.1:8188
COMFY_WORKFLOW_DIR=./workflows

TTS_PROVIDER=kokoro                   # kokoro | chatterbox | elevenlabs
KOKORO_VOICE_FR=ff_siwis
KOKORO_VOICE_EN=af_heart

# YouTube (mêmes identifiants OAuth que le dashboard)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CREDENTIALS_KEY=

# Alertes mail
ALERT_EMAIL_TO=adresse@example.com
RESEND_API_KEY=                       # ou SMTP_* ci-dessous
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
