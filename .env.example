# ---------------------------------------------------------------------------
# Dashboard (apps/dashboard/.env.local)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # routes serveur uniquement (cron métriques, OAuth callback)
CREDENTIALS_KEY=                      # 32 octets base64 : chiffrement des refresh tokens
GOOGLE_CLIENT_ID=                     # OAuth "application Web", redirect: https://<dashboard>/api/youtube/callback
GOOGLE_CLIENT_SECRET=
OAUTH_STATE_SECRET=                   # aléatoire : signe le paramètre state du flux OAuth
NEXT_PUBLIC_APP_URL=http://localhost:3000  # base des redirections OAuth (prod : https://<dashboard>)
NEXT_PUBLIC_MOCK=1                    # 1 = données factices (démo sans Supabase)
DASHBOARD_AUTH=none                   # none = usage local sur ton PC (aucune connexion) | supabase = login + app_users (hébergement public)

# ---------------------------------------------------------------------------
# Worker local (services/worker/.env)
# ---------------------------------------------------------------------------
# Supabase en local (npx supabase start, lancé par le lanceur) : valeurs par défaut de la CLI.
# Pour un projet hébergé : chaîne « Session pooler », URL https://<ref>.supabase.co et clé service_role.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=            # affichée par : npx supabase --workdir C:\YouTube2\supabase-workdir status
WORKER_ID=desktop-3070
# Types de jobs traités par ce worker (liste par défaut dans worker/config.py si la ligne est supprimée).
WORKER_JOB_TYPES=script,storyboard,render,generate_clip,tts,seo,assemble,qa,upload,ideate,improve,strategy,sync_metrics,sync_retention,sync_comments,import_channel,voice_preview,montage_preview,analyze,tiktok_publish
# Clips, voix, montages. Sous Windows, l'accès contrôlé aux dossiers bloque l'écriture dans
# Documents/Images/Vidéos : tout ce qui s'écrit vit dans C:\YouTube2, sur le disque interne (docs/11 §8).
DATA_DIR=C:/YouTube2/data

# Fournisseurs (pluggables, voir docs/03-pipeline.md)
# Les réglages IA du dashboard (Réglages → Intelligence artificielle : fournisseur, modèles, clés chiffrées en base)
# priment sur les lignes ci-dessous, qui restent le repli.
LLM_PROVIDER=gemini                   # principal : gemini | anthropic | mistral | ollama
LLM_FALLBACKS=mistral,gemini,ollama   # secours, dans l'ordre (un fournisseur sans clé est ignoré)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Vidéo : un workflow ComfyUI de services/worker/workflows/ (docs/11 §4 pour les modèles à télécharger)
VIDEO_PROVIDER=comfy_wan22_5b_i2v     # Wan 2.2 TI2V-5B (installé) ; meilleure qualité : comfy_wan22_i2v_4step (14B GGUF + LoRA 4 passes, docs/12 §5)
VIDEO_SIZE=                           # vide = résolution native (480x832) ; 704x1280 = 720p natif du 5B, ~2,5× plus long
COMFY_BASE_URL=http://127.0.0.1:8188
COMFY_IMAGE_WORKFLOW=wan22_5b_t2i     # images du storyboard : wan22_5b_t2i (installé) | zimage_turbo (meilleur) | flux1_schnell_gguf
STORYBOARD_ENABLED=1                  # une image par scène avant l'animation
STORYBOARD_REVIEW=1                   # 1 = validation humaine des images (dashboard → Création, ou yt2 storyboard …), 0 = automatique
STORYBOARD_CANDIDATES=2               # images proposées par scène
# Continuité entre clips (docs/12 §4) : script = l'agent script décide scène par scène | chain = chaque clip
# part de la dernière image du précédent | cut = chaque clip part de son image de storyboard
CLIP_CONTINUITY=script
CONTINUITY_MAX_CHAIN=3                # clips enchaînés au plus avant de repartir d'une image (dérive)
# Formats visuels (docs/15) : retouche des images clés d'un chantier en accéléré ; repli si son modèle manque
COMFY_EDIT_WORKFLOW=qwen_image_edit_2511_4step   # 4 passes, ≈ 1 min 30 | qwen_image_edit_2511 (40 passes : 13 min, RAM saturée)
COMFY_EDIT_FALLBACK=zimage_img2img         # Z-Image image → image, installé
# Gemini en ligne (docs/17) : bouton ✦ Gemini de Création, clips par l'appli Gemini pilotée dans un Chrome dédié
# (extra « web » : uv sync --extra web). Tout est facultatif ; compte, durée et modèle se règlent dans le dashboard.
# GEMINI_PROFILE_DIR=C:/YouTube2/data/gemini-chrome   # défaut : DATA_DIR/gemini-chrome (connexion Google faite à la main)
# GEMINI_CDP_PORT=9333                 # port de pilotage du Chrome dédié, sur 127.0.0.1 seulement
# GEMINI_POLL_MINUTES=3                # vidéo demandée : on revient voir toutes les N minutes
# GEMINI_QUOTA_RETRY_MINUTES=60        # limite atteinte sans heure lisible : nouvel essai après N minutes
# GEMINI_MAX_WAIT_HOURS=6              # vidéo toujours absente après N heures : clip en échec

# Montage. Titre d'accroche, sous-titres et textes à l'écran : onglet Montage du dashboard (modèle de montage,
# docs/23-montage.md) ; les polices ajoutées depuis l'onglet vont dans DATA_DIR/fonts.
VIDEO_ENCODER=auto                    # auto (NVENC si disponible) | nvenc | cpu
SUBTITLE_PROFILE=impact               # aperçus de la CLI seulement (yt2 subtitles preview) : impact | karaoke | sobre | affiche | bd
# MUSIC_LIBRARY_DIR=C:/…/music         # musiques de Luca (docs/26-musique.md) ; défaut : dossier « music » du dépôt
# MUSIC_DIR=C:/YouTube2-data/music    # ancienne bibliothèque générée, à défaut : DATA_DIR/music/<ambiance>/*.mp3
# SFX_DIR=C:/YouTube2/data/sfx        # défaut : DATA_DIR/sfx/<étiquette>/ (bruitages, yt2 sfx list)

TTS_PROVIDER=kokoro                   # kokoro | chatterbox | elevenlabs
KOKORO_VOICE_FR=ff_siwis
KOKORO_VOICE_EN=af_heart
KOKORO_SPEED=1.05                     # défaut si channels.voice_speed est absent

# Agents SEO et stratégie
SEO_ENABLED=1
STRATEGY_WINDOW_DAYS=28
STRATEGY_MIN_VIDEOS=6                 # en dessous : statistiques sans proposition

# Séries de contenu et production automatique (docs/12 §1)
AUTO_PRODUCE=1                        # concepts approuvés par « yt2 concepts approve » → production ; le ✓ de Création la crée tout de suite ; 0 = jamais
PRODUCTIONS_PER_DAY=3
MAX_PRODUCTIONS_IN_FLIGHT=3
IDEAS_PER_SERIES=6                    # sous ce nombre de concepts en attente, l'agent idée de la série est relancé
WIKIPEDIA_USER_AGENT=                 # défaut : yt2-worker/0.1 (+ALERT_EMAIL_TO), exigé par Wikimedia

# YouTube (mêmes identifiants OAuth que le dashboard)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CREDENTIALS_KEY=

# TikTok par Zernio (docs/36) : la clé se colle dans Réglages → TikTok (chiffrée en base avec CREDENTIALS_KEY).
# Celle-ci ne sert que de repli (CLI, base neuve). Ne jamais la mettre dans le dépôt.
ZERNIO_API_KEY=

# Mail « vidéo terminée » (docs/32) : se règle dans Réglages → Notifications, qui prime sur ces valeurs
ALERT_EMAIL_TO=adresse@example.com   # adresse qui reçoit
NOTIFY_ON_REVIEW=1                    # 1 = un mail dès qu'une vidéo est terminée (montée et contrôlée)
SMTP_HOST=                            # défaut : smtp.gmail.com
SMTP_PORT=465                         # 465 = SSL, 587 = STARTTLS
SMTP_USER=                            # compte Gmail qui envoie
SMTP_PASS=                            # son mot de passe d'application (16 lettres, myaccount.google.com/apppasswords)
RESEND_API_KEY=                       # autre voie d'envoi, sans SMTP
DASHBOARD_URL=http://localhost:3000   # liens des mails
